# Keep the build context small and secret-free. Secrets are passed at run time (env_file / -e).
.env
.env.*
**/.env
**/.env.*
*.pem
*.key

.git
.github
.venv
**/.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
**/.DS_Store

# Runtime state lives in volumes, never in the image.
data/
reports/

# Node: dependencies are installed and the UI is built inside the image.
**/node_modules
frontend/dist
frontend/coverage
e2e/

# Tests aren't shipped, except the synthetic demo fixture `paindisc demo` reads.
tests/
!tests/fixtures/demo_docs.jsonl

docs/
Dockerfile
docker-compose*.yml
.dockerignore
