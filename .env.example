# Copy to .env and fill in. Without ANTHROPIC_API_KEY everything runs in mock mode.
ANTHROPIC_API_KEY=

# Optional: raises GitHub search from 10 to 30 requests/minute.
GITHUB_TOKEN=

# Optional: web discovery (snippets only) via the Brave Search API.
BRAVE_API_KEY=

# Identify your crawler with a contact address (used for pricing pages and robots.txt).
PAINDISC_USER_AGENT="paindisc/0.1 (research; contact: you@example.com)"

# Salt for hashing usernames. Change it once and keep it stable.
PAINDISC_SALT=change-me

LLM_MOCK=false
# PAINDISC_MODEL_TRIAGE=claude-haiku-5-5
# PAINDISC_MODEL_EXTRACT=claude-sonnet-5-5
# PAINDISC_MODEL_SYNTH=claude-opus-5-5
